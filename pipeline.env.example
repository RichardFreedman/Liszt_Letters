# =====================================================================
#  Pipeline settings — shared by all three notebooks
#  (1_Transcription, 2_Chroma_DB_Builder, 3_RAG_Query)
#
#  Edit the values after the "=" signs, save the file, then re-run the
#  "Setup" cell of whichever notebook you are using.
#  Keep this file private: it contains your API keys.
# =====================================================================

# --- API keys ---------------------------------------------------------
# Paste your keys after the "=". If left blank, the keys already set in
# your computer's environment (if any) are used instead.
ANTHROPIC_API_KEY=''
VOYAGE_API_KEY=''

# --- Claude model: used for transcription AND for answering questions --
# Options: claude-opus-5-5 (best), claude-sonnet-5-5 (cheaper),
#          claude-haiku-4-5 (cheapest), claude-fable-5-1 (most capable, most expensive)
CLAUDE_MODEL=claude-opus-5-5
# How hard Claude thinks: low | medium | high | xhigh | max  (ignored by Haiku)
CLAUDE_EFFORT=high

# --- Embeddings: used to build AND to search the Chroma database --------
# "voyage" = Voyage AI, the embeddings provider Anthropic recommends (needs VOYAGE_API_KEY)
# "local"  = free model that runs on this computer (needs: pip install sentence-transformers)
EMBEDDING_PROVIDER=voyage
# voyage models: voyage-3.5, voyage-3.5-lite, voyage-3-large
# local models:  intfloat/multilingual-e5-base
EMBEDDING_MODEL=voyage-3.5

# --- Image preparation (applied to every page before it is sent to Claude)
# Longest edge in pixels; larger images are shrunk, smaller ones left alone.
MAX_IMAGE_PX=2500
JPEG_QUALITY=82
# Resolution used to turn PDF pages into images
PDF_DPI=200

# --- Folders and files (relative to this project folder) ---------------
INPUT_IMAGE_DIR=input_images
INPUT_MANIFEST=input_image_manifest.csv
TRANSCRIPTION_RULES=transcription_rules.md
OUTPUT_MD_DIR=output_transcription_md
OUTPUT_MANIFEST=output_transcr_manifest.csv
CHROMA_DIR=chroma-db
CHROMA_COLLECTION=transcriptions
